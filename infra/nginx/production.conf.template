upstream nextjs_production {
    server app:3000;
    keepalive 16;
}

log_format observability escape=json '{"event":"http_request","method":"$request_method",'
    '"path":"$uri","status":$status,"duration_seconds":$request_time,'
    '"upstream_duration_seconds":"$upstream_response_time","request_id":"$request_id"}';

server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log off;
    location = /health/live {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"nginx"}';
    }
    location / { return 308 https://$host:${HTTPS_PORT}$request_uri; }
}

server {
    listen 8443 ssl;
    server_name _;
    server_tokens off;
    charset utf-8;
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    access_log /dev/stdout observability;
    access_log syslog:server=promtail:1515,tag=nginx observability;
    error_log /dev/stderr warn;
    error_log syslog:server=promtail:1516,tag=nginx warn;
    client_max_body_size 51m;
    client_body_timeout 120s;
    send_timeout 120s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Request-ID $request_id always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    location = /api/metrics { return 404; }
    location / {
        proxy_pass http://nextjs_production;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
    }
}

server {
    listen 8082;
    server_name _;
    access_log off;
    location = /stub_status { stub_status; }
    location / { return 404; }
}
