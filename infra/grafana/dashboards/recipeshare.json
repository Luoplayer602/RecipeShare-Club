      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(recipeshare_api_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(recipeshare_api_requests_total[5m])),0.001)",
