{
  "uid": "recipeshare-infrastructure",
  "title": "RecipeShare — MySQL & Containers",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "recipeshare",
    "infrastructure",
    "mysql",
    "docker"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "recipeshare-prometheus"
        },
        "definition": "label_values(docker_container_mem_usage{job=\"containers\"}, com_docker_compose_project)",
        "query": {
          "query": "label_values(docker_container_mem_usage{job=\"containers\"}, com_docker_compose_project)",
          "refId": "Project"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "MySQL available",
      "type": "stat",
      "description": "1 means exporter authenticated and collected MySQL metrics, rather than merely returning HTTP.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_up{job=\"mysql\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "MySQL connected threads",
      "type": "stat",
      "description": "Current connections, including monitoring and application pools.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_threads_connected{job=\"mysql\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "MySQL connection capacity used",
      "type": "stat",
      "description": "Connected threads as a percentage of configured max_connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * mysql_global_status_threads_connected{job=\"mysql\"} / mysql_global_variables_max_connections{job=\"mysql\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Containers reporting running state",
      "type": "stat",
      "description": "Sampled running containers in this Compose project. Collector refresh is 15s; previous label sets expire after 45s.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(docker_container_status_uptime_ns{job=\"containers\",com_docker_compose_project=~\"$project\",container_status=\"running\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "MySQL queries / second",
      "type": "timeseries",
      "description": "All MySQL statements, including healthchecks and exporter queries; this is not application request count.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_queries{job=\"mysql\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "MySQL buffer pool data",
      "type": "timeseries",
      "description": "InnoDB buffer pool data bytes; not total MySQL process or container RAM.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_innodb_buffer_pool_bytes_data{job=\"mysql\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Container CPU — 100% = one logical core",
      "type": "timeseries",
      "description": "Docker CPU percentage. Multicore usage may exceed 100%. Next.js runs on Windows and is not part of these container statistics.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docker_container_cpu_usage_percent{job=\"containers\",com_docker_compose_project=~\"$project\",container_status=\"running\",cpu=\"cpu-total\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "{{com_docker_compose_service}} / {{container_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Container memory usage",
      "type": "timeseries",
      "description": "Docker memory usage bytes; may include cache. Compare trends with docker stats, whose cache handling can differ.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docker_container_mem_usage{job=\"containers\",com_docker_compose_project=~\"$project\",container_status=\"running\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "{{com_docker_compose_service}} / {{container_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Container network receive / second",
      "type": "timeseries",
      "description": "Total across container network interfaces. Counter resets after container recreation are handled by rate().",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(docker_container_net_rx_bytes{job=\"containers\",com_docker_compose_project=~\"$project\",container_status=\"running\",network=\"total\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "{{com_docker_compose_service}} / {{container_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Container network transmit / second",
      "type": "timeseries",
      "description": "Includes all container traffic: scrapes, DB, logs, API and healthchecks.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(docker_container_net_tx_bytes{job=\"containers\",com_docker_compose_project=~\"$project\",container_status=\"running\",network=\"total\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "{{com_docker_compose_service}} / {{container_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "MySQL uptime",
      "type": "stat",
      "description": "Time since MySQL started, not time since exporter started.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_uptime{job=\"mysql\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 12,
      "title": "Docker collector errors",
      "type": "stat",
      "description": "Cumulative gather failures since Telegraf started. A scrape can succeed even when Docker statistics gathering fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 27,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "internal_gather_errors{job=\"containers\",input=\"docker\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 13,
      "title": "MySQL exporter scrape",
      "type": "stat",
      "description": "Exporter scrape connectivity. Compare with mysql_up above.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"mysql\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 14,
      "title": "Container exporter scrape",
      "type": "stat",
      "description": "Exporter scrape connectivity; this alone does not prove resource statistics exist.",
      "datasource": {
        "type": "prometheus",
        "uid": "recipeshare-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 27,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"containers\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "recipeshare-prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    }
  ]
}
