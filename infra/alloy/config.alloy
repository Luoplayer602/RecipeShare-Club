logging {
  level = "info"
}

// Only application syslog is collected here; Nginx goes exclusively to Promtail.
loki.source.syslog "nextjs" {
  listener {
    address = "0.0.0.0:1514"
    protocol = "udp"
    syslog_format = "rfc5424"
    labels = { service_name = "nextjs", environment = sys.env("LOG_ENVIRONMENT"), collector = "alloy" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
